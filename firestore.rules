rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isSuperAdminEmail() {
      return isAuthenticated() && 
             request.auth.token != null && 
             'email' in request.auth.token && 
             request.auth.token.email == 'abirmohsin02@gmail.com';
    }

    function hasRole(role) {
      return isAuthenticated() && 
             request.auth.uid != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        hasRole('admin') || 
        hasRole('super_admin')
      );
    }

    function isTeacher() {
      return isAuthenticated() && (hasRole('teacher') || hasRole('academic_officer') || isAdmin());
    }

    function isLibraryStaff() {
      return isAuthenticated() && (hasRole('library_staff') || isAdmin());
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /users_profile/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isTeacher());
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }
    
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read, write: if isAuthenticated();
    }

    match /schedules/{scheduleId} {
      allow read, write: if isAuthenticated();
    }

    match /assignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }

    match /submissions/{submissionId} {
      allow read, write: if isAuthenticated();
    }

    match /materials/{materialId} {
      allow read, write: if isAuthenticated();
    }

    match /attendance/{attendanceId} {
      allow read, write: if isAuthenticated();
    }

    match /marks/{marksId} {
      allow read, write: if isAuthenticated();
    }

    match /guardian_links/{linkId} {
      allow read, write: if isAuthenticated();
    }

    match /fees/{feeId} {
      allow read, write: if isAuthenticated();
    }

    match /research_papers/{paperId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /library_books/{bookId} {
      allow read: if true;
      allow write: if isLibraryStaff();
    }

    match /library_resources/{resourceId} {
      allow read: if true;
      allow write: if isLibraryStaff();
    }

    match /book_loans/{loanId} {
      allow read, write: if isAuthenticated();
    }

    match /borrow_requests/{reqId} {
      allow read, write: if isAuthenticated();
    }

    match /course_videos/{videoId} {
      allow read, write: if isAuthenticated();
    }

    match /site_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Faculty & Scholars Directory
    match /faculty_profiles/{profileId} {
      allow read: if true;
      allow write, delete: if isAuthenticated();
    }

    // Contact and Inquiry Messages from About / Public Pages
    match /contact_messages/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // System Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // Alumni Portal Collections
    match /alumni_profiles/{profileId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /alumni_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alumni_event_registrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /alumni_jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.postedBy == request.auth.uid);
    }

    match /alumni_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alumni_discussions/{discussionId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /alumni_contributions/{contribId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
